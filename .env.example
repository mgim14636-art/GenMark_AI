# MariaDB Database Configuration
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=genmark_db
MARIADB_USER=genmark_user
MARIADB_PASSWORD=genmark_pass
MARIADB_ROOT_PASSWORD=genmark_root_pass

# Backend Spring Boot Configuration
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
AI_SERVER_URL=http://ai-server:8000

# AI Server FastAPI Configuration
AI_SERVER_PORT=8000
FASTAPI_ENV=development
MODEL_CACHE_DIR=./data/models
FAISS_INDEX_PATH=./data/faiss/trademark.index
HUGGINGFACE_TOKEN=your_hf_token_here

# Nginx Configuration
NGINX_PORT=80
