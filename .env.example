# ── 배포 방법 ─────────────────────────────────────────────
# pub 서버(genmark-pub-svr): docker compose --profile pub up -d   (nginx만 기동)
# pri 서버(genmark-pri-svr): docker compose --profile pri up -d   (backend/ai-server/database 기동)
# 두 서버 모두 이 .env.example을 복사해 .env로 만들고, 서버 역할에 맞는 값만 채우면 된다.
# ──────────────────────────────────────────────────────────

# DB. Keep real credentials only in the ignored root .env file.
# - 로컬 개발: 캠퍼스 공용 DB (project-db-campus.smhrd.com)
# - pri 서버 운영 배포: DB_HOST=database, DB_PORT=3306, DB_SSL_MODE=disable
#   (database는 이 compose 파일의 pri 프로필 컨테이너 이름, 같은 서버 안에서만 접근)
DB_HOST=project-db-campus.smhrd.com
DB_PORT=3308
DB_NAME=
DB_APP_USER=
DB_APP_PASSWORD=
DB_SSL_MODE=verify-full
# pri 서버의 database 컨테이너(운영 DB) 최초 생성 시 root 계정 비밀번호. pri 서버 .env에만 설정.
DB_ROOT_PASSWORD=

# Backend
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8081
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14
GOOGLE_CLIENT_ID=
KAKAO_REST_API_KEY=
AUTH_FAKE_PROVIDER_ENABLED=false
# pub 서버 배포 시 실제 접속 도메인/IP로 바꿔야 한다 (예: http://101.79.25.193 또는 발급받은 도메인).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI services
AI_SERVER_URL=http://ai-server:8000
AI_SERVER_PORT=8000
LOGO_WORDMARK=model
FASTAPI_ENV=development
MODEL_CACHE_DIR=./data/models
EMBEDDINGS_PATH=/app/data/faiss/embeddings.npy
IDS_PATH=/app/data/faiss/ids.csv
DATA_MANIFEST_PATH=/app/data/faiss/data_manifest.json
TRADEMARK_METADATA_PATH=/app/data/trademarks/meta/trademarks.csv
TRADEMARK_DATA_ROOT=/app/data/trademarks
DINO_MODEL_ID=facebook/dinov2-base
DINO_MODEL_REVISION=f9e44c814b77203eaa57a6bdbbd535f21ede1415
HUGGINGFACE_TOKEN=
NVIDIA_API_KEY=
KIPRIS_API_KEY=
OPENROUTER_API_KEY=

# Nginx
NGINX_PORT=80

# Optional disposable local-db profile only.
LOCAL_DB_PORT=3307
LOCAL_DB_NAME=genmark_db
LOCAL_DB_USER=genmark_user
LOCAL_DB_PASSWORD=genmark_pass
LOCAL_DB_ROOT_PASSWORD=genmark_root_pass
