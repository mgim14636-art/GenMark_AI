# MariaDB Database Configuration
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=genmark_db
MARIADB_USER=genmark_user
MARIADB_PASSWORD=genmark_pass
MARIADB_ROOT_PASSWORD=genmark_root_pass

# Backend Spring Boot Configuration
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
AI_SERVER_URL=http://ai-server:8000

# AI Server FastAPI Configuration
AI_SERVER_PORT=8000
FASTAPI_ENV=development
MODEL_CACHE_DIR=./data/models
FAISS_INDEX_PATH=./data/faiss/trademark.index
HUGGINGFACE_TOKEN=your_hf_token_here

# Nginx Configuration
NGINX_PORT=80

# JWT (백엔드 자체 발급 액세스 토큰 서명 키)
# 운영 배포 전 반드시 32바이트 이상의 랜덤 값으로 교체할 것 (예: openssl rand -base64 48)
JWT_SECRET=genmark-ai-local-dev-only-jwt-secret-please-change
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14

# Social Login (구글/카카오 개발자 콘솔에서 발급)
GOOGLE_CLIENT_ID=
KAKAO_REST_API_KEY=

# 로컬 개발 전용: provider=fake 로그인 허용 여부 (운영에서는 반드시 false)
AUTH_FAKE_PROVIDER_ENABLED=true
