FASTAPI_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional for downloading the public DINOv2 model used by similarity search.
HUGGINGFACE_TOKEN=
MODEL_CACHE_DIR=./data/models

# 유사도 검색 데이터 경로 (컨테이너 기준. 로컬 실행 시 ./ai-server/data 로 대체)
EMBEDDINGS_PATH=/app/data/faiss/embeddings.npy
IDS_PATH=/app/data/faiss/ids.csv
DATA_MANIFEST_PATH=/app/data/faiss/data_manifest.json
TRADEMARK_METADATA_PATH=/app/data/trademarks/meta/trademarks.csv
TRADEMARK_DATA_ROOT=/app/data/trademarks

# 재현성을 위해 모델 revision을 고정한다.
DINO_MODEL_ID=facebook/dinov2-base
DINO_MODEL_REVISION=f9e44c814b77203eaa57a6bdbbd535f21ede1415

# 로고 생성 — OpenRouter Image API (https://openrouter.ai). 실제 키는 커밋 금지.
OPENROUTER_API_KEY=

# 기본값은 recraft-v4-vector. 모델 비교 실험으로 확정했다
# (scripts/compare_models.py, docs/api/ai-api.md).
#   - 벡터(SVG)라 지정한 HEX가 오차 없이 그대로 나오고, 배경 path를 지우면
#     투명 배경이 정확히 만들어진다. 확대·축소도 무손실.
#   - 슬러그가 "-vector"로 끝나면 SVG 응답으로 처리한다(logo_gen_service.is_vector).
#     래스터 모델로 되돌리려면 예: black-forest-labs/flux.2-pro
#   - Recraft 계열은 seed를 받지 않는다(넘기면 400). 자동으로 제외된다.
OPENROUTER_MODEL=recraft/recraft-v4-vector

# 한글 핵심가치 → 영문 로고 키워드 변환용 OpenRouter 텍스트 모델.
# 비우면 서버 기본 Solar 모델을 사용하며 NOTE_MODEL과는 독립적으로 동작한다.
VALUE_KEYWORD_MODEL=upstage/solar-pro4
VALUE_KEYWORD_TIMEOUT_SECONDS=5
MOTIF_TRANSLATION_MODEL=upstage/solar-pro4
MOTIF_TRANSLATION_TIMEOUT_SECONDS=5

# KIPRIS Plus trademark data collection. Never commit the real credential.
KIPRIS_API_KEY=

# 검출 상표가 왜 닮았는지 한 줄 설명(note) 생성용.
# 없으면 note 없이 유사도 결과만 반환한다(정상 동작) — 점수는 이 설정과 무관하다.
#
# NOTE_PROVIDER를 비워두면 OPENROUTER_API_KEY가 있을 때 openrouter를,
# 없으면 gemini를 쓴다. 두 무료 등급의 할당량이 서로 독립이라, 한쪽이 429일 때
# 이 한 줄만 바꿔 갈아탈 수 있다.
NOTE_PROVIDER=openrouter          # openrouter | gemini

# openrouter일 때 쓰는 모델. 이미지 입력을 받는 모델이어야 한다
# (쿼리 로고 1장 + 검출 상표 3장을 함께 넣는 멀티모달 작업).
# 후보 확인: python scripts/compare_llms.py --list --vision
NOTE_MODEL=google/gemini-2.5-flash-lite

# gemini일 때 쓰는 키·모델
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

NOTE_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------------------
# 로고 생성 동작 스위치
#
# 넷 다 기본값이 서비스 기준이다. 결과가 예상과 다를 때 한 번에 하나씩 뒤집어
# 원인을 좁히는 용도이며, 평상시에는 건드릴 필요가 없다.
# ---------------------------------------------------------------------------

# 프롬프트 빌더. brief | legacy
#
#   brief  : 설문 사실만 담은 짧은 브리프(약 260자). 조형은 모델에 맡긴다.
#   legacy : 모티프와 조형(도형 개수·선 굵기·구도·디자인 사조)까지 지시하던
#            예전 프롬프트(약 1,150자).
#
# 통제 실험(2026-08-16): Recraft 사이트에서 같은 모델 V4 Vector에 두 프롬프트를
# 넣어 비교했다. 짧은 브리프는 완성도 높은 락업을, legacy는 동심원 선 뭉치를
# 만들었다. 플랫폼·모델이 같았으므로 차이는 프롬프트뿐이다.
# 상세 근거는 prompt_service.build_prompt_brief 위 주석 참고.
LOGO_PROMPT=brief

# 락업 정규화. on | off
#
# 생성 모델은 마크를 매번 다른 크기로 그려 준다. on이면 심볼을 캔버스 높이의
# 38%로 다시 앉히고 심볼+워드마크를 정중앙 정렬해, 시안마다 비율이 제각각인
# 문제를 없앤다. off면 모델이 준 크기를 그대로 쓴다(A/B 비교용).
LOGO_LOCKUP=on

# 단색 강제. on | off
#
# 사용자가 색을 하나만 골랐을 때, 생성된 SVG의 잉크 색을 그 색으로 통일한다.
# 프롬프트로는 보장되지 않아서 필요하다 — "single stroke color"를 명시해도
# 모델이 보조색을 얹는 사례가 반복 확인됐다.
# 밝기 205 이상인 면은 흰색으로 남긴다(선 로고의 빈 속이 메워지는 것을 방지).
LOGO_FORCE_COLOR=on

# 마감. solid | outline
#
# 화면에 선택 항목이 생기기 전까지 전체 기본값을 바꿔 실험하는 용도다.
# 설문에 logo_finish 값이 들어오면 그쪽이 우선한다.
LOGO_FINISH=solid

# 브랜드명을 누가 그리는가. composer | model
#
#   composer(기본) : 모델은 심볼만 그리고 이 서버가 폰트로 이름을 합성한다.
#                    글자가 절대 깨지지 않는다. 한글도 지원된다.
#   model          : 모델이 심볼과 워드마크를 한 덩어리 락업으로 그린다.
#                    잘 나오면 완성도가 확실히 높지만, 긴 이름에서 글자가
#                    심볼에 가려지는 사고가 있다(실측: "GlowLab"의 o/a).
#                    시안을 여러 장 뽑아 고를 수 있을 때만 쓴다.
#                    한글 브랜드명과 심볼 스타일은 이 모드에서도 제외된다.
LOGO_WORDMARK=composer
