FASTAPI_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional for downloading the public DINOv2 model used by similarity search.
HUGGINGFACE_TOKEN=
MODEL_CACHE_DIR=./data/models

# 유사도 검색 데이터 경로 (컨테이너 기준. 로컬 실행 시 ./ai-server/data 로 대체)
EMBEDDINGS_PATH=/app/data/faiss/embeddings.npy
IDS_PATH=/app/data/faiss/ids.csv
DATA_MANIFEST_PATH=/app/data/faiss/data_manifest.json
TRADEMARK_METADATA_PATH=/app/data/trademarks/meta/trademarks.csv
TRADEMARK_DATA_ROOT=/app/data/trademarks

# 재현성을 위해 모델 revision을 고정한다.
DINO_MODEL_ID=facebook/dinov2-base
DINO_MODEL_REVISION=f9e44c814b77203eaa57a6bdbbd535f21ede1415

# 로고 생성 — OpenRouter Image API (https://openrouter.ai). 실제 키는 커밋 금지.
OPENROUTER_API_KEY=

# 기본값은 recraft-v4-vector. 모델 비교 실험으로 확정했다
# (scripts/compare_models.py, docs/api/ai-api.md).
#   - 벡터(SVG)라 지정한 HEX가 오차 없이 그대로 나오고, 배경 path를 지우면
#     투명 배경이 정확히 만들어진다. 확대·축소도 무손실.
#   - 슬러그가 "-vector"로 끝나면 SVG 응답으로 처리한다(logo_gen_service.is_vector).
#     래스터 모델로 되돌리려면 예: black-forest-labs/flux.2-pro
#   - Recraft 계열은 seed를 받지 않는다(넘기면 400). 자동으로 제외된다.
OPENROUTER_MODEL=recraft/recraft-v4-vector

# KIPRIS Plus trademark data collection. Never commit the real credential.
KIPRIS_API_KEY=

# 검출 상표가 왜 닮았는지 한 줄 설명(note) 생성용.
# 없으면 note 없이 유사도 결과만 반환한다(정상 동작) — 점수는 이 설정과 무관하다.
#
# NOTE_PROVIDER를 비워두면 OPENROUTER_API_KEY가 있을 때 openrouter를,
# 없으면 gemini를 쓴다. 두 무료 등급의 할당량이 서로 독립이라, 한쪽이 429일 때
# 이 한 줄만 바꿔 갈아탈 수 있다.
NOTE_PROVIDER=openrouter          # openrouter | gemini

# openrouter일 때 쓰는 모델. 이미지 입력을 받는 모델이어야 한다
# (쿼리 로고 1장 + 검출 상표 3장을 함께 넣는 멀티모달 작업).
# 후보 확인: python scripts/compare_llms.py --list --free --vision
NOTE_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# gemini일 때 쓰는 키·모델
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

NOTE_TIMEOUT_SECONDS=8
