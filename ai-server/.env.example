FASTAPI_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional for downloading the public DINOv2 model used by similarity search.
HUGGINGFACE_TOKEN=
MODEL_CACHE_DIR=./data/models
FAISS_INDEX_PATH=./data/faiss/trademark.index
METADATA_STORE_PATH=./data/faiss/metadata.json

# NVIDIA Build API (FLUX.2 klein logo generation). Never commit the real value.
NVIDIA_API_KEY=

# KIPRIS Plus trademark data collection. Never commit the real value.
KIPRIS_API_KEY=
